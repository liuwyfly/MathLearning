# 开发环境
NODE_ENV=development

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=stallion
MYSQL_PASSWORD=app_pass1234
MYSQL_DATABASE=Lagrange

# app route prefix
FASTIFY_ROUTE_PREFIX=/math-learning

# JWT signing secret (use a long random string in production)
JWT_SECRET=870c03eddf8d8c0aa71ed27c95554829fbe2

# Register validation code (to prevent unauthorized public registration)
REGISTER_VALIDATION_CODE=your_secret_code_here


# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# prisma mysql connection
DATABASE_URL=mysql://stallion:app_pass1234@localhost:3306/Lagrange?connection_limit=1&pool_timeout=30&connect_timeout=10

# ! Do not commit OSS credentials
# OSS credentials

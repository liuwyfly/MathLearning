generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "mysql"
}

model Article {
  id               Int               @id @default(autoincrement()) @db.UnsignedInt
  title            String            @db.VarChar(256)
  title_en         String?           @db.VarChar(384)
  created_at       DateTime          @default(now()) @db.DateTime(3)
  updated_at       DateTime          @default(now()) @db.DateTime(3)
  contentsArticles ContentsArticle[]
  problems         Problem[]

  @@map("mathlearning_article")
}

model Contents {
  id               Int               @id @default(autoincrement()) @db.UnsignedInt
  name             String            @db.VarChar(256)
  name_en          String?           @db.VarChar(256)
  oss_path         String?           @db.VarChar(256)
  sort             Float             @default(0) @db.Float
  created_at       DateTime          @default(now()) @db.DateTime(3)
  updated_at       DateTime          @default(now()) @db.DateTime(3)
  contentsArticles ContentsArticle[]

  @@map("mathlearning_contents")
}

model ContentsArticle {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  contents_id  Int      @db.UnsignedInt
  article_id   Int      @db.UnsignedInt
  article_sort Float    @default(0) @db.Float
  created_at   DateTime @default(now()) @db.DateTime(3)
  article      Article  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contentsarticle_article_id")
  contents     Contents @relation(fields: [contents_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_contentsarticle_contents_id")

  @@unique([contents_id, article_id], map: "uk_content_article")
  @@index([article_id], map: "fk_contentsarticle_article_id")
  @@index([article_sort], map: "idx_contentsarticle_article_sort")
  @@map("mathlearning_contents_articles")
}

model Markdown {
  id         Int    @id @default(autoincrement()) @db.UnsignedInt
  name       String @default("") @db.VarChar(256)
  oss_path   String @db.VarChar(352)
  article_id Int    @db.UnsignedInt
  sort       Float  @default(0) @db.Float
  language   String @db.VarChar(6)

  created_at DateTime @default(now()) @db.DateTime(3)

  @@index([article_id], map: "idx_markdown_article_id")
  @@index([sort], map: "idx_markdown_sort")
  @@map("mathlearning_markdown")
}

model Problem {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  title      String   @db.VarChar(255)
  math_text  String   @db.Text
  answer     String   @db.Text
  language   String   @db.VarChar(6)
  sort       Float    @default(0) @db.Float
  article_id Int      @db.UnsignedInt
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @default(now()) @db.DateTime(3)

  article       Article        @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_problem_article_id")
  problemImages ProblemImage[]

  @@index([article_id], map: "idx_problem_article_id")
  @@index([sort], map: "idx_problem_sort")
  @@map("mathlearning_problem")
}

model ProblemImage {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  path       String   @db.VarChar(352)
  article_id Int      @db.UnsignedInt
  problem_id Int      @db.UnsignedInt
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @default(now()) @db.DateTime(3)
  problem    Problem  @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_problem_image_problem_id")

  @@index([article_id], map: "idx_problem_image_article_id")
  @@index([problem_id], map: "idx_problem_image_problem_id")
  @@map("mathlearning_problem_image")
}
